# Milvus 向量数据库
MILVUS_URI=http://localhost:19530
MILVUS_DB=default

# Embedding 模型
EMBEDDING_BASE_URL=http://localhost:9911/v1
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_API_KEY=your-embedding-api-key

# Reranker 模型
RERANKER_BASE_URL=http://localhost:19913/v1
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-8B
RERANKER_API_KEY=your-reranker-api-key

# LLM
LLM_BASE_URL=http://localhost:9912/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=Qwen/Qwen3.5-27B

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_SECURE=false
